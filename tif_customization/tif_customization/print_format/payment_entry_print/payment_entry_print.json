 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\nhtml, body {\n  width: 100% !important;\n  background: #fff;\n}\n\n.container,\n.page-content,\n.print-preview {\n  width: 100% !important;\n  max-width: 100% !important;\n}\n\n@page {\n  size: A4 portrait;\n  margin: 8mm 10mm;\n}\n\n.print-format {\n  font-family: Arial, sans-serif;\n  font-size: 9.5px;\n  color: #111;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.sheet {\n  width: 100%;\n  min-height: 125mm;\n  max-height: 135mm;\n  border: 1px solid #111;\n  padding: 8px 10px;\n  overflow: hidden;\n  position: relative;\n  box-sizing: border-box;\n}\n\n.content {\n  position: relative;\n  z-index: 2;\n}\n\n/* Watermark */\n.wm {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  pointer-events: none;\n  z-index: 1;\n}\n\n.wm span {\n  font-size: 52px;\n  font-weight: 900;\n  letter-spacing: 6px;\n  color: rgba(17, 24, 39, 0.04);\n  transform: rotate(-20deg);\n  text-transform: uppercase;\n}\n\n/* Header */\n.header {\n  display: grid;\n  grid-template-columns: 120px 1fr 170px;\n  gap: 8px;\n  align-items: start;\n  margin-bottom: 6px;\n}\n\n.brand {\n  text-align: center;\n}\n\n.brand .name {\n  font-size: 14px;\n  font-weight: 900;\n  text-transform: uppercase;\n  letter-spacing: .4px;\n  line-height: 1.1;\n}\n\n.brand .city {\n  margin-top: 1px;\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n.brand .type {\n  margin-top: 4px;\n  padding: 3px 0;\n  border-top: 1px solid #111;\n  border-bottom: 1px solid #111;\n  font-size: 10.5px;\n  font-weight: 900;\n  text-transform: uppercase;\n  letter-spacing: .5px;\n}\n\n.meta {\n  text-align: right;\n  font-size: 9.5px;\n  line-height: 1.45;\n  padding-top: 20px;\n}\n\n.meta .k {\n  color: #555;\n  font-weight: 700;\n}\n\n.meta .v {\n  font-weight: 900;\n}\n\n/* Status */\n.status-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 4px 7px;\n  border-radius: 20px;\n  border: 1px solid #ddd;\n  background: #f8f8f8;\n  font-size: 8.8px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: #999;\n}\n\n.dot.green { background: #22c55e; }\n.dot.red { background: #ef4444; }\n.dot.gray { background: #9ca3af; }\n\n.stamp {\n  position: absolute;\n  top: 6px;\n  right: 8px;\n  padding: 3px 7px;\n  border: 1px solid rgba(17, 24, 39, 0.18);\n  border-radius: 20px;\n  background: rgba(17, 24, 39, 0.04);\n  font-size: 8.5px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n/* Cards */\n.cards {\n  display: grid;\n  grid-template-columns: 1fr 1.25fr;\n  gap: 6px;\n  margin-top: 6px;\n}\n\n.card {\n  border: 1px solid #ddd;\n  border-radius: 7px;\n  padding: 6px 7px;\n  background: #fff;\n}\n\n.card h3 {\n  margin: 0 0 4px 0;\n  font-size: 8.8px;\n  letter-spacing: .4px;\n  text-transform: uppercase;\n  font-weight: 900;\n}\n\n.grid2 {\n  display: grid;\n  grid-template-columns: 105px 1fr;\n  gap: 3px 6px;\n}\n\n.lbl {\n  color: #666;\n  font-weight: 700;\n}\n\n.val {\n  font-weight: 900;\n  color: #111;\n  word-break: break-word;\n}\n\n/* QR */\n.qrwrap {\n  display: flex;\n  justify-content: space-between;\n  gap: 6px;\n}\n\n.qrwrap img {\n  width: 52px;\n  height: 52px;\n  border: 1px solid #ddd;\n  border-radius: 6px;\n  padding: 3px;\n  background: #fff;\n}\n\n.qrcap {\n  font-size: 7.8px;\n  color: #666;\n  margin-top: 3px;\n  line-height: 1.1;\n  text-align: right;\n  font-weight: 700;\n}\n\n/* Sections */\n.section {\n  margin-top: 6px;\n}\n\n.section-title {\n  font-size: 8.8px;\n  font-weight: 900;\n  letter-spacing: .4px;\n  text-transform: uppercase;\n  margin: 0 0 3px 0;\n}\n\n/* Table */\n.table {\n  width: 100%;\n  border: 1px solid black;\n  border-collapse: collapse;\n  table-layout: fixed;\n}\n\n.table th {\n  background: #f6f6f6;\n  padding: 4px 5px;\n  font-size: 10px;\n  text-align: center;\n  border: 1px solid black;\n  font-weight: 900;\n  color: black !important;\n}\n\n.table td {\n  padding: 4px 5px;\n  border: 1px solid black;\n  font-weight: 500;\n  vertical-align: top;\n  word-break: break-word;\n  font-size: 11px;\n}\n\n.right {\n  text-align: right;\n}\n\n.muted {\n  color: #666;\n  font-weight: 700;\n}\n\n/* Remarks */\n.remarks-box {\n  border: 1px solid #ddd;\n  border-radius: 7px;\n  padding: 6px 7px;\n  background: #fff;\n  font-size: 9px;\n  font-weight: 700;\n  line-height: 1.35;\n  min-height: 22px;\n  word-break: break-word;\n}\n\n/* Total */\n.total {\n  display: grid;\n  grid-template-columns: 1fr 145px;\n  gap: 8px;\n  margin-top: 6px;\n  padding: 6px 8px;\n  border: 1px solid #111;\n  border-radius: 7px;\n  align-items: center;\n}\n\n.total .words {\n  font-weight: 900;\n  font-size: 9px;\n}\n\n.total .amt {\n  font-weight: 900;\n  font-size: 11px;\n  text-align: right;\n  white-space: nowrap;\n}\n\n/* Summary rows */\n.summary-box {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 5px;\n  margin-top: 6px;\n}\n\n.summary-item {\n  border: 1px solid #ddd;\n  border-radius: 6px;\n  padding: 5px;\n}\n\n.summary-label {\n  font-size: 8px;\n  color: #666;\n  font-weight: 700;\n}\n\n.summary-value {\n  font-size: 9.2px;\n  font-weight: 900;\n  margin-top: 2px;\n}\n\n/* Signature */\n.sign {\n  /*margin-top: 6px;*/\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 18px;\n}\n\n.sig {\n  text-align: center;\n  font-size: 8.8px;\n  font-weight: 900;\n}\n\n.line {\n  border-top: 1px solid #111;\n  margin-bottom: 3px;\n  padding-top: 12px;\n}\n\n/* Footer */\n.footer-note {\n  margin-top: 5px;\n  font-size: 7.8px;\n  color: #666;\n  font-weight: 700;\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n.footer-note .righttxt {\n  text-align: right;\n}\n\n/* Prevent extra page */\n.print-format,\n.sheet,\n.content {\n  page-break-inside: avoid !important;\n}\n\n@media print {\n  .print-format {\n    page-break-after: avoid !important;\n  }\n\n  .sheet {\n    page-break-inside: avoid !important;\n  }\n}\n</style>\n\n{# ================= DATA - PAYMENT ENTRY ================= #}\n\n{% set company = doc.company %}\n{% set city = \"Karachi\" %}\n{% set voucher_no = doc.name %}\n{% set date = frappe.utils.formatdate(doc.posting_date) %}\n{% set company_currency = doc.company_currency or \"PKR\" %}\n\n{% set voucher_url = frappe.utils.get_url(\"/app/payment-entry/\" + doc.name) %}\n{% set qr = \"\" %}\n{% if frappe.utils.get_qr_code %}\n  {% set qr = frappe.utils.get_qr_code(voucher_url) %}\n{% endif %}\n\n{% if doc.docstatus == 1 %}\n  {% set status_text = \"Submitted\" %}\n  {% set watermark_text = \"PAID\" %}\n  {% set stamp_text = \"POSTED\" %}\n  {% set dot_class = \"green\" %}\n{% elif doc.docstatus == 2 %}\n  {% set status_text = \"Cancelled\" %}\n  {% set watermark_text = \"CANCELLED\" %}\n  {% set stamp_text = \"CANCELLED\" %}\n  {% set dot_class = \"red\" %}\n{% else %}\n  {% set status_text = \"Draft\" %}\n  {% set watermark_text = \"DRAFT\" %}\n  {% set stamp_text = \"DRAFT\" %}\n  {% set dot_class = \"gray\" %}\n{% endif %}\n\n{% set payment_type = doc.get(\"payment_type\") or \"\" %}\n{% set mode_of_payment = doc.get(\"mode_of_payment\") or \"\" %}\n{% set party_type = doc.get(\"party_type\") or \"Party\" %}\n{% set party = doc.get(\"party\") or \"\" %}\n{% set party_name = doc.get(\"party_name\") or party %}\n{% set paid_amount = doc.get(\"paid_amount\") or 0 %}\n{% set bank_transaction = doc.get(\"bank_transaction\") or \"\" %}\n{% set paid_from = doc.get(\"paid_from\") or \"\" %}\n{% set paid_to = doc.get(\"paid_to\") or \"\" %}\n{% set remarks = doc.get(\"remarks\") or \"\" %}\n\n{% if payment_type == \"Pay\" %}\n  {% set from_label = \"Paid From\" %}\n  {% set to_label = \"Paid To\" %}\n{% else %}\n  {% set from_label = \"Received From\" %}\n  {% set to_label = \"Deposited To\" %}\n{% endif %}\n\n{% set reference_no = doc.get(\"reference_no\") or doc.get(\"reference_number\") or \"\" %}\n{% set reference_date = doc.get(\"reference_date\") or doc.get(\"cheque_date\") or \"\" %}\n\n{% set total_allocated_amount = doc.get(\"total_allocated_amount\") or 0 %}\n{% set unallocated_amount = doc.get(\"unallocated_amount\") or 0 %}\n{% set difference_amount = doc.get(\"difference_amount\") or 0 %}\n{% set total_taxes_and_charges = doc.get(\"total_taxes_and_charges\") or 0 %}\n{% set words = frappe.utils.money_in_words(paid_amount, company_currency) %}\n\n<div class=\"print-format\">\n  <div class=\"sheet\">\n\n    <div class=\"wm\">\n      <span>{{ watermark_text }}</span>\n    </div>\n\n    <div class=\"stamp\">{{ stamp_text }}</div>\n\n    <div class=\"content\">\n\n      <!-- HEADER -->\n      <div class=\"header\">\n        <div>\n          <div class=\"status-chip\">\n            <span class=\"dot {{ dot_class }}\"></span>\n            {{ status_text }}\n          </div>\n        </div>\n\n        <div class=\"brand\">\n          <div class=\"name\">{{ company }}</div>\n          <div class=\"city\">{{ city }}</div>\n          <div class=\"type\">Payment Voucher</div>\n        </div>\n\n        <div class=\"meta\">\n          <div><span class=\"k\">Voucher No:</span> <span class=\"v\">{{ voucher_no }}</span></div>\n          <div><span class=\"k\">Date:</span> <span class=\"v\">{{ date }}</span></div>\n        </div>\n      </div>\n\n      <!-- TOP DETAILS -->\n      <div class=\"cards\">\n\n        <div class=\"card\">\n          <h3>Payment Details</h3>\n          <div class=\"grid2\">\n            <div class=\"lbl\">Payment Type</div>\n            <div class=\"val\">{{ payment_type or \"\u2014\" }}</div>\n\n            <div class=\"lbl\">Mode</div>\n            <div class=\"val\">{{ mode_of_payment or \"\u2014\" }}</div>\n\n            <div class=\"lbl\">Bank Transaction</div>\n            <div class=\"val\">{{ bank_transaction or \"\u2014\" }}</div>\n\n            <div class=\"lbl\">Reference No</div>\n            <div class=\"val\">{{ reference_no or \"\u2014\" }}</div>\n\n            <div class=\"lbl\">Reference Date</div>\n            <div class=\"val\">\n              {% if reference_date %}\n                {{ frappe.utils.formatdate(reference_date) }}\n              {% else %}\n                \u2014\n              {% endif %}\n            </div>\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"qrwrap\">\n            <div style=\"flex: 1;\">\n              <h3>Party / Account Details</h3>\n              <div class=\"grid2\">\n                <div class=\"lbl\">{{ party_type }}</div>\n                <div class=\"val\">{{ party or \"\u2014\" }}</div>\n\n                <div class=\"lbl\">Party Name</div>\n                <div class=\"val\">{{ party_name or \"\u2014\" }}</div>\n\n                <div class=\"lbl\">{{ from_label }}</div>\n                <div class=\"val\">{{ paid_from or \"\u2014\" }}</div>\n\n                <div class=\"lbl\">{{ to_label }}</div>\n                <div class=\"val\">{{ paid_to or \"\u2014\" }}</div>\n              </div>\n            </div>\n\n            <div style=\"text-align:right;\">\n              {% if qr %}\n                <img src=\"{{ qr }}\" alt=\"QR\">\n                <div class=\"qrcap\">Scan<br>{{ doc.name }}</div>\n              {% endif %}\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- PAYMENT REFERENCES -->\n      <div class=\"section\">\n        <div class=\"section-title\">Payment References</div>\n\n        <table class=\"table\">\n          <thead>\n            <tr>\n              <th style=\"width:28px;\">No</th>\n              <th style=\"width:90px;\">Type</th>\n              <th>Name</th>\n              <th style=\"width:78px;\" class=\"right\">Grand Total</th>\n              <th style=\"width:78px;\" class=\"right\">Outstanding</th>\n              <th style=\"width:78px;\" class=\"right\">Allocated</th>\n            </tr>\n          </thead>\n          <tbody>\n            {% if doc.references and doc.references|length > 0 %}\n              {% for r in doc.references %}\n                {% if loop.index <= 4 %}\n                  <tr>\n                    <td>{{ loop.index }}</td>\n                    <td>{{ r.reference_doctype or \"\u2014\" }}</td>\n                    <td>{{ r.reference_name or \"\u2014\" }}</td>\n                    <td class=\"right\">{{ \"%.2f\"|format(r.total_amount or 0) }}</td>\n                    <td class=\"right\">{{ \"%.2f\"|format(r.outstanding_amount or 0) }}</td>\n                    <td class=\"right\">{{ \"%.2f\"|format(r.allocated_amount or 0) }}</td>\n                  </tr>\n                {% endif %}\n              {% endfor %}\n\n              {% if doc.references|length > 4 %}\n                <tr>\n                  <td colspan=\"6\" class=\"muted\">\n                    Showing first 4 references only. Total references: {{ doc.references|length }}\n                  </td>\n                </tr>\n              {% endif %}\n            {% else %}\n              <tr>\n                <td colspan=\"6\" class=\"muted\">No references found.</td>\n              </tr>\n            {% endif %}\n          </tbody>\n        </table>\n      </div>\n\n      <!-- SUMMARY -->\n      <div class=\"summary-box\">\n        <div class=\"summary-item\">\n          <div class=\"summary-label\">Paid Amount</div>\n          <div class=\"summary-value\">{{ \"%.2f\"|format(paid_amount) }}</div>\n        </div>\n\n        <div class=\"summary-item\">\n          <div class=\"summary-label\">Allocated</div>\n          <div class=\"summary-value\">{{ \"%.2f\"|format(total_allocated_amount) }}</div>\n        </div>\n\n        <div class=\"summary-item\">\n          <div class=\"summary-label\">Unallocated</div>\n          <div class=\"summary-value\">{{ \"%.2f\"|format(unallocated_amount) }}</div>\n        </div>\n\n        <div class=\"summary-item\">\n          <div class=\"summary-label\">Difference</div>\n          <div class=\"summary-value\">{{ \"%.2f\"|format(difference_amount) }}</div>\n        </div>\n      </div>\n\n      <!-- REMARKS -->\n      {% if remarks %}\n        <div class=\"section\">\n          <div class=\"section-title\">Remarks</div>\n          <div class=\"remarks-box\">\n            {{ remarks }}\n          </div>\n        </div>\n      {% endif %}\n\n      <!-- TOTAL -->\n      <div class=\"total\">\n        <div class=\"words\">{{ words }}</div>\n        <div class=\"amt\">{{ company_currency }} {{ \"%.2f\"|format(paid_amount) }}</div>\n      </div>\n\n      <br><br>\n\n      <!-- SIGNATURES -->\n      <div class=\"sign\">\n        <div class=\"sig\"><div class=\"line\"></div>Prepared By</div>\n        <div class=\"sig\"><div class=\"line\"></div>Approved By</div>\n        <div class=\"sig\"><div class=\"line\"></div>Received By</div>\n      </div>\n\n    </div>\n  </div>\n</div>",
