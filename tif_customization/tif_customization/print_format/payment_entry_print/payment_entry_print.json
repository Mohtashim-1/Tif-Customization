{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2025-12-16 16:35:39.700807",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Payment Entry",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\nhtml,\nbody {\n  width: 100% !important;\n  background: #fff;\n}\n\n.container,\n.page-content,\n.print-preview {\n  width: 100% !important;\n  max-width: 100% !important;\n}\n\n@page {\n  size: A4 portrait;\n  margin: 8mm 10mm;\n}\n\n.print-format {\n  margin: 0 !important;\n  padding: 0 !important;\n  font-family: Arial, Helvetica, sans-serif;\n  font-size: 9.5px;\n  color: #111;\n}\n\n.sheet {\n  position: relative;\n  width: 100%;\n  min-height: 135mm;\n  border: 1px solid #111;\n  padding: 8px 10px;\n  overflow: hidden;\n  box-sizing: border-box;\n  background: #fff;\n}\n\n.content {\n  position: relative;\n  z-index: 2;\n}\n\n/* Watermark */\n.wm {\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  pointer-events: none;\n}\n\n.wm span {\n  color: rgba(17, 24, 39, 0.04);\n  font-size: 52px;\n  font-weight: 900;\n  letter-spacing: 6px;\n  text-transform: uppercase;\n  transform: rotate(-20deg);\n}\n\n/* Header */\n.header {\n  display: grid;\n  grid-template-columns: 120px 1fr 190px;\n  gap: 8px;\n  align-items: start;\n  margin-bottom: 6px;\n}\n\n.brand {\n  text-align: center;\n}\n\n.brand .name {\n  font-size: 14px;\n  font-weight: 900;\n  line-height: 1.1;\n  letter-spacing: 0.4px;\n  text-transform: uppercase;\n}\n\n.brand .city {\n  margin-top: 1px;\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n.brand .type {\n  margin-top: 4px;\n  padding: 3px 0;\n  border-top: 1px solid #111;\n  border-bottom: 1px solid #111;\n  font-size: 10.5px;\n  font-weight: 900;\n  letter-spacing: 0.5px;\n  text-transform: uppercase;\n}\n\n.meta {\n  padding-top: 20px;\n  font-size: 9.5px;\n  line-height: 1.45;\n  text-align: right;\n}\n\n.meta .k {\n  color: #555;\n  font-weight: 700;\n}\n\n.meta .v {\n  font-weight: 900;\n}\n\n/* Status */\n.status-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 4px 7px;\n  border: 1px solid #ddd;\n  border-radius: 20px;\n  background: #f8f8f8;\n  font-size: 8.8px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: #999;\n}\n\n.dot.green {\n  background: #22c55e;\n}\n\n.dot.red {\n  background: #ef4444;\n}\n\n.dot.gray {\n  background: #9ca3af;\n}\n\n.stamp {\n  position: absolute;\n  top: 6px;\n  right: 8px;\n  padding: 3px 7px;\n  border: 1px solid rgba(17, 24, 39, 0.18);\n  border-radius: 20px;\n  background: rgba(17, 24, 39, 0.04);\n  font-size: 8.5px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n/* Top detail cards */\n.cards {\n  display: grid;\n  grid-template-columns: 1fr 1.25fr;\n  gap: 6px;\n  margin-top: 6px;\n}\n\n.card {\n  padding: 6px 7px;\n  border: 1px solid #bbb;\n  border-radius: 5px;\n  background: #fff;\n}\n\n.card h3 {\n  margin: 0 0 5px;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 0.4px;\n  text-transform: uppercase;\n}\n\n.grid2 {\n  display: grid;\n  grid-template-columns: 105px 1fr;\n  gap: 3px 6px;\n}\n\n.lbl {\n  color: #555;\n  font-weight: 700;\n}\n\n.val {\n  color: #111;\n  font-weight: 900;\n  word-break: break-word;\n}\n\n/* QR */\n.qrwrap {\n  display: flex;\n  justify-content: space-between;\n  gap: 6px;\n}\n\n.qrwrap img {\n  width: 52px;\n  height: 52px;\n  padding: 3px;\n  border: 1px solid #ddd;\n  border-radius: 5px;\n  background: #fff;\n}\n\n.qrcap {\n  margin-top: 3px;\n  color: #666;\n  font-size: 7.8px;\n  font-weight: 700;\n  line-height: 1.1;\n  text-align: right;\n}\n\n/* Sections */\n.section {\n  margin-top: 7px;\n}\n\n.section-title {\n  margin: 0 0 4px;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 0.4px;\n  text-transform: uppercase;\n}\n\n/* Reference table */\n.table {\n  width: 100%;\n  border: 1px solid #111;\n  border-collapse: collapse;\n  table-layout: fixed;\n}\n\n.table th {\n  padding: 5px 4px;\n  border: 1px solid #111;\n  background: #f5f5f5;\n  color: #111 !important;\n  font-size: 9.5px;\n  font-weight: 900;\n  text-align: center;\n  vertical-align: middle;\n}\n\n.table td {\n  padding: 5px 4px;\n  border: 1px solid #111;\n  font-size: 10px;\n  font-weight: 600;\n  vertical-align: top;\n  word-break: break-word;\n}\n\n.right {\n  text-align: right;\n}\n\n.center {\n  text-align: center;\n}\n\n.muted {\n  color: #666;\n  font-weight: 700;\n}\n\n/* Summary */\n.summary-box {\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  gap: 5px;\n  margin-top: 7px;\n}\n\n.summary-item {\n  padding: 5px;\n  border: 1px solid #bbb;\n  border-radius: 5px;\n  background: #fff;\n}\n\n.summary-label {\n  color: #555;\n  font-size: 8px;\n  font-weight: 700;\n}\n\n.summary-value {\n  margin-top: 2px;\n  font-size: 9.5px;\n  font-weight: 900;\n}\n\n.summary-item.tax {\n  background: #fffdf2;\n}\n\n.summary-item.net {\n  border: 1px solid #111;\n  background: #f7f7f7;\n}\n\n.summary-item.net .summary-label,\n.summary-item.net .summary-value {\n  color: #111;\n  font-weight: 900;\n}\n\n/* Tax details */\n.tax-details {\n  margin-top: 6px;\n  border: 1px solid #bbb;\n  border-radius: 5px;\n  overflow: hidden;\n}\n\n.tax-details-header {\n  padding: 4px 6px;\n  border-bottom: 1px solid #bbb;\n  background: #f5f5f5;\n  font-size: 8.8px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.tax-row {\n  display: grid;\n  grid-template-columns: 1fr 110px;\n  border-bottom: 1px solid #ddd;\n}\n\n.tax-row:last-child {\n  border-bottom: none;\n}\n\n.tax-row div {\n  padding: 4px 6px;\n  font-size: 9px;\n  font-weight: 700;\n}\n\n.tax-row .tax-amount {\n  border-left: 1px solid #ddd;\n  font-weight: 900;\n  text-align: right;\n}\n\n/* Remarks */\n.remarks-box {\n  min-height: 27px;\n  padding: 7px 8px;\n  border: 1px solid #bbb;\n  border-radius: 5px;\n  background: #fff;\n  font-size: 11px;\n  font-weight: 700;\n  line-height: 1.45;\n  word-break: break-word;\n}\n\n/* Total */\n.total {\n  display: grid;\n  grid-template-columns: 1fr 155px;\n  gap: 8px;\n  align-items: center;\n  margin-top: 7px;\n  padding: 7px 9px;\n  border: 1px solid #111;\n  border-radius: 6px;\n}\n\n.total .words {\n  font-size: 10px;\n  font-weight: 900;\n  text-transform: capitalize;\n}\n\n.total .amt {\n  font-size: 12px;\n  font-weight: 900;\n  text-align: right;\n  white-space: nowrap;\n}\n\n/* Signatures */\n.sign {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 28px;\n  margin-top: 38px;\n}\n\n.sig {\n  font-size: 9px;\n  font-weight: 900;\n  text-align: center;\n}\n\n.line {\n  min-height: 25px;\n  margin-bottom: 4px;\n  border-bottom: 1px solid #111;\n}\n\n/* Prevent extra page */\n.print-format,\n.sheet,\n.content,\n.table,\n.summary-box,\n.total,\n.sign {\n  page-break-inside: avoid !important;\n  break-inside: avoid !important;\n}\n\n@media print {\n  .print-format {\n    page-break-after: avoid !important;\n  }\n\n  .sheet {\n    page-break-inside: avoid !important;\n    break-inside: avoid !important;\n  }\n}\n</style>\n\n{# ================= PAYMENT ENTRY DATA ================= #}\n\n{% set company = doc.company %}\n{% set city = \"Karachi\" %}\n{% set voucher_no = doc.name %}\n{% set date = frappe.utils.formatdate(doc.posting_date) %}\n{% set company_currency = doc.company_currency or \"PKR\" %}\n\n{% set voucher_url = frappe.utils.get_url(\"/app/payment-entry/\" + doc.name) %}\n{% set qr = \"\" %}\n\n{% if frappe.utils.get_qr_code %}\n  {% set qr = frappe.utils.get_qr_code(voucher_url) %}\n{% endif %}\n\n{# ================= STATUS ================= #}\n\n{% if doc.docstatus == 1 %}\n  {% set status_text = \"Submitted\" %}\n  {% set watermark_text = \"PAID\" %}\n  {% set stamp_text = \"POSTED\" %}\n  {% set dot_class = \"green\" %}\n{% elif doc.docstatus == 2 %}\n  {% set status_text = \"Cancelled\" %}\n  {% set watermark_text = \"CANCELLED\" %}\n  {% set stamp_text = \"CANCELLED\" %}\n  {% set dot_class = \"red\" %}\n{% else %}\n  {% set status_text = \"Draft\" %}\n  {% set watermark_text = \"DRAFT\" %}\n  {% set stamp_text = \"DRAFT\" %}\n  {% set dot_class = \"gray\" %}\n{% endif %}\n\n{# ================= BASIC VALUES ================= #}\n\n{% set payment_type = doc.get(\"payment_type\") or \"\" %}\n{% set mode_of_payment = doc.get(\"mode_of_payment\") or \"\" %}\n{% set party_type = doc.get(\"party_type\") or \"Party\" %}\n{% set party = doc.get(\"party\") or \"\" %}\n{% set party_name = doc.get(\"party_name\") or party %}\n{% set paid_amount = doc.get(\"paid_amount\") or 0 %}\n{% set bank_transaction = doc.get(\"bank_transaction\") or \"\" %}\n{% set paid_from = doc.get(\"paid_from\") or \"\" %}\n{% set paid_to = doc.get(\"paid_to\") or \"\" %}\n{% set remarks = doc.get(\"remarks\") or \"\" %}\n\n{% set reference_no =\n  doc.get(\"reference_no\")\n  or doc.get(\"reference_number\")\n  or \"\"\n%}\n\n{% set reference_date =\n  doc.get(\"reference_date\")\n  or doc.get(\"cheque_date\")\n  or \"\"\n%}\n\n{% set total_allocated_amount = doc.get(\"total_allocated_amount\") or 0 %}\n{% set unallocated_amount = doc.get(\"unallocated_amount\") or 0 %}\n{% set difference_amount = doc.get(\"difference_amount\") or 0 %}\n\n{# ================= TAX CALCULATION ================= #}\n\n{#\n   ERPNext normally stores withholding tax or deduction entries\n   inside the deductions child table.\n\n   This code first calculates tax from doc.deductions.\n   If no deduction rows are available, it uses\n   total_taxes_and_charges as a fallback.\n#}\n\n{% set tax = namespace(total=0) %}\n\n{% if doc.get(\"deductions\") %}\n  {% for deduction in doc.get(\"deductions\") %}\n    {% set deduction_amount = deduction.get(\"amount\") or 0 %}\n\n    {% if deduction_amount < 0 %}\n      {% set deduction_amount = deduction_amount * -1 %}\n    {% endif %}\n\n    {% set tax.total = tax.total + deduction_amount %}\n  {% endfor %}\n{% endif %}\n\n{% if tax.total == 0 %}\n  {% set fallback_tax = doc.get(\"total_taxes_and_charges\") or 0 %}\n\n  {% if fallback_tax < 0 %}\n    {% set fallback_tax = fallback_tax * -1 %}\n  {% endif %}\n\n  {% set tax.total = fallback_tax %}\n{% endif %}\n\n{% set tax_deducted = tax.total %}\n\n{#\n   Gross amount is normally the allocated invoice amount.\n   When references are unavailable, paid amount is used.\n#}\n\n{% if total_allocated_amount > 0 %}\n  {% set gross_amount = total_allocated_amount %}\n{% else %}\n  {% set gross_amount = paid_amount %}\n{% endif %}\n\n{% set net_paid_amount = gross_amount - tax_deducted %}\n\n{% if net_paid_amount < 0 %}\n  {% set net_paid_amount = 0 %}\n{% endif %}\n\n{% set words = frappe.utils.money_in_words(\n  net_paid_amount,\n  company_currency\n) %}\n\n{# ================= ACCOUNT LABELS ================= #}\n\n{% if payment_type == \"Pay\" %}\n  {% set from_label = \"Paid From\" %}\n  {% set to_label = \"Paid To\" %}\n{% else %}\n  {% set from_label = \"Received From\" %}\n  {% set to_label = \"Deposited To\" %}\n{% endif %}\n\n<div class=\"print-format\">\n  <div class=\"sheet\">\n\n    <!-- WATERMARK -->\n    <div class=\"wm\">\n      <span>{{ watermark_text }}</span>\n    </div>\n\n    <!-- STATUS STAMP -->\n    <div class=\"stamp\">{{ stamp_text }}</div>\n\n    <div class=\"content\">\n\n      <!-- HEADER -->\n      <div class=\"header\">\n\n        <div>\n          <div class=\"status-chip\">\n            <span class=\"dot {{ dot_class }}\"></span>\n            {{ status_text }}\n          </div>\n        </div>\n\n        <div class=\"brand\">\n          <div class=\"name\">{{ company }}</div>\n          <div class=\"city\">{{ city }}</div>\n          <div class=\"type\">Payment Voucher</div>\n        </div>\n\n        <div class=\"meta\">\n          <div>\n            <span class=\"k\">Voucher No:</span>\n            <span class=\"v\">{{ voucher_no }}</span>\n          </div>\n\n          <div>\n            <span class=\"k\">Date:</span>\n            <span class=\"v\">{{ date }}</span>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- PAYMENT AND PARTY DETAILS -->\n      <div class=\"cards\">\n\n        <div class=\"card\">\n          <h3>Payment Details</h3>\n\n          <div class=\"grid2\">\n\n            <div class=\"lbl\">Payment Type</div>\n            <div class=\"val\">{{ payment_type or \"\u2014\" }}</div>\n\n            <div class=\"lbl\">Mode</div>\n            <div class=\"val\">{{ mode_of_payment or \"\u2014\" }}</div>\n\n            <div class=\"lbl\">Bank Transaction</div>\n            <div class=\"val\">{{ bank_transaction or \"\u2014\" }}</div>\n\n            <div class=\"lbl\">Reference No</div>\n            <div class=\"val\">{{ reference_no or \"\u2014\" }}</div>\n\n            <div class=\"lbl\">Reference Date</div>\n            <div class=\"val\">\n              {% if reference_date %}\n                {{ frappe.utils.formatdate(reference_date) }}\n              {% else %}\n                \u2014\n              {% endif %}\n            </div>\n\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"qrwrap\">\n\n            <div style=\"flex: 1;\">\n              <h3>Party / Account Details</h3>\n\n              <div class=\"grid2\">\n\n                <div class=\"lbl\">{{ party_type }}</div>\n                <div class=\"val\">{{ party or \"\u2014\" }}</div>\n\n                <div class=\"lbl\">Party Name</div>\n                <div class=\"val\">{{ party_name or \"\u2014\" }}</div>\n\n                <div class=\"lbl\">{{ from_label }}</div>\n                <div class=\"val\">{{ paid_from or \"\u2014\" }}</div>\n\n                <div class=\"lbl\">{{ to_label }}</div>\n                <div class=\"val\">{{ paid_to or \"\u2014\" }}</div>\n\n              </div>\n            </div>\n\n            <div style=\"text-align: right;\">\n              {% if qr %}\n                <img src=\"{{ qr }}\" alt=\"QR Code\">\n                <div class=\"qrcap\">\n                  Scan<br>\n                  {{ doc.name }}\n                </div>\n              {% endif %}\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n\n      <!-- PAYMENT REFERENCES -->\n      <div class=\"section\">\n        <div class=\"section-title\">Payment References</div>\n\n        <table class=\"table\">\n          <thead>\n            <tr>\n              <th style=\"width: 30px;\">No</th>\n              <th style=\"width: 95px;\">Type</th>\n              <th>Name</th>\n              <th style=\"width: 86px;\">Grand Total</th>\n              <th style=\"width: 86px;\">Outstanding</th>\n              <th style=\"width: 86px;\">Allocated</th>\n            </tr>\n          </thead>\n\n          <tbody>\n            {% if doc.references and doc.references|length > 0 %}\n\n              {% for r in doc.references %}\n                {% if loop.index <= 4 %}\n                  <tr>\n                    <td class=\"center\">\n                      {{ loop.index }}\n                    </td>\n\n                    <td>\n                      {{ r.reference_doctype or \"\u2014\" }}\n                    </td>\n\n                    <td>\n                      {{ r.reference_name or \"\u2014\" }}\n                    </td>\n\n                    <td class=\"right\">\n                      {{ \"%.2f\"|format(r.total_amount or 0) }}\n                    </td>\n\n                    <td class=\"right\">\n                      {{ \"%.2f\"|format(r.outstanding_amount or 0) }}\n                    </td>\n\n                    <td class=\"right\">\n                      {{ \"%.2f\"|format(r.allocated_amount or 0) }}\n                    </td>\n                  </tr>\n                {% endif %}\n              {% endfor %}\n\n              {% if doc.references|length > 4 %}\n                <tr>\n                  <td colspan=\"6\" class=\"muted\">\n                    Showing first 4 references only.\n                    Total references: {{ doc.references|length }}\n                  </td>\n                </tr>\n              {% endif %}\n\n            {% else %}\n              <tr>\n                <td colspan=\"6\" class=\"muted center\">\n                  No references found.\n                </td>\n              </tr>\n            {% endif %}\n          </tbody>\n        </table>\n      </div>\n\n      <!-- PAYMENT SUMMARY -->\n      <div class=\"summary-box\">\n\n        <div class=\"summary-item\">\n          <div class=\"summary-label\">Gross Amount</div>\n          <div class=\"summary-value\">\n            {{ \"%.2f\"|format(gross_amount) }}\n          </div>\n        </div>\n\n        <div class=\"summary-item\">\n          <div class=\"summary-label\">Allocated</div>\n          <div class=\"summary-value\">\n            {{ \"%.2f\"|format(total_allocated_amount) }}\n          </div>\n        </div>\n\n        <div class=\"summary-item tax\">\n          <div class=\"summary-label\">Tax Deducted</div>\n          <div class=\"summary-value\">\n            {{ \"%.2f\"|format(tax_deducted) }}\n          </div>\n        </div>\n\n        <div class=\"summary-item\">\n          <div class=\"summary-label\">Unallocated</div>\n          <div class=\"summary-value\">\n            {{ \"%.2f\"|format(unallocated_amount) }}\n          </div>\n        </div>\n\n        <div class=\"summary-item net\">\n          <div class=\"summary-label\">Net Paid Amount</div>\n          <div class=\"summary-value\">\n            {{ \"%.2f\"|format(net_paid_amount) }}\n          </div>\n        </div>\n\n      </div>\n\n      <!-- TAX DEDUCTION DETAILS -->\n      {% if tax_deducted > 0 %}\n        <div class=\"tax-details\">\n\n          <div class=\"tax-details-header\">\n            Tax / Deduction Details\n          </div>\n\n          {% if doc.get(\"deductions\") %}\n\n            {% for deduction in doc.get(\"deductions\") %}\n\n              {% set row_amount = deduction.get(\"amount\") or 0 %}\n\n              {% if row_amount < 0 %}\n                {% set row_amount = row_amount * -1 %}\n              {% endif %}\n\n              <div class=\"tax-row\">\n                <div>\n                  {{ deduction.get(\"account\") or \"Tax Deduction\" }}\n\n                  {% if deduction.get(\"cost_center\") %}\n                    \u2014 {{ deduction.get(\"cost_center\") }}\n                  {% endif %}\n                </div>\n\n                <div class=\"tax-amount\">\n                  {{ company_currency }}\n                  {{ \"%.2f\"|format(row_amount) }}\n                </div>\n              </div>\n\n            {% endfor %}\n\n          {% else %}\n\n            <div class=\"tax-row\">\n              <div>Tax Deducted</div>\n\n              <div class=\"tax-amount\">\n                {{ company_currency }}\n                {{ \"%.2f\"|format(tax_deducted) }}\n              </div>\n            </div>\n\n          {% endif %}\n\n        </div>\n      {% endif %}\n\n      <!-- REMARKS -->\n      {% if remarks %}\n        <div class=\"section\">\n          <div class=\"section-title\">Remarks</div>\n\n          <div class=\"remarks-box\">\n            {{ remarks }}\n          </div>\n        </div>\n      {% endif %}\n\n      <!-- NET TOTAL -->\n      <div class=\"total\">\n        <div class=\"words\">\n          {{ words }}\n        </div>\n\n        <div class=\"amt\">\n          {{ company_currency }}\n          {{ \"%.2f\"|format(net_paid_amount) }}\n        </div>\n      </div>\n\n      <!-- SIGNATURES -->\n      <div class=\"sign\">\n\n        <div class=\"sig\">\n          <div class=\"line\"></div>\n          Accountant\n        </div>\n\n        <div class=\"sig\">\n          <div class=\"line\"></div>\n          CFO / COO\n        </div>\n\n        <div class=\"sig\">\n          <div class=\"line\"></div>\n          Receiver\n        </div>\n\n      </div>\n\n    </div>\n  </div>\n</div>",
