 "html": "<style>\n    .print-format {\n        padding: 0px;\n    }\n    @media screen {\n        .print-format {\n            padding: 0in;\n        }\n    }\n    @media print {\n        @page {\n            size: portrait;\n            margin: 0;\n        }\n        .cheque-rotate {\n            transform: rotate(90deg);\n            transform-origin: top left;\n            position: absolute;\n            top: 0;\n            left: 20.0cm; /* same as your cheque height */\n            width: 35.0cm;\n            height: 9.0cm;\n        }\n    }\n    @media screen {\n        .cheque-rotate {\n            /* show normal on screen for editing */\n            transform: none;\n        }\n    }\n</style>\n\n<div class=\"cheque-rotate\">\n    <div style=\"position: relative; top:0.0cm\">\n        <div style=\"width:35.0cm; height:9.0cm;\">\n\n            <span style=\"position: absolute; top:0.6cm; left: 19cm;\">\n                {% set d = frappe.utils.formatdate(doc.reference_date, 'dd/MM/yyyy') %}\n                {% set parts = d.split('/') %}\n                {% set dd = parts[0] %}\n                {% set mm = parts[1] %}\n                {% set yyyy = parts[2] %}\n                {% for ch in [dd[0], dd[1]] %}\n                <span style=\"display:inline-block; width:0.6cm; height:0.7cm; \n                             text-align:center; line-height:0.7cm;  margin-right:1px;font-size:24px; \">{{ ch }}</span>\n                {% endfor %}\n                {% for ch in [mm[0], mm[1]] %}\n                <span style=\"display:inline-block; width:0.6cm; height:0.7cm; \n                             text-align:center; line-height:0.7cm;  margin-right:0px;font-size:24px; \">{{ ch }}</span>\n                {% endfor %}\n                {% for ch in [yyyy[0], yyyy[1], yyyy[2], yyyy[3]] %}\n                <span style=\"display:inline-block; width:0.6cm; height:0.7cm; \n                             text-align:center; line-height:0.7cm;  margin-right:0px;font-size:24px; \">{{ ch }}</span>\n                {% endfor %}\n            </span>\n\n            <span style=\"top:5.0cm; left:10.0cm; font-size:24px; font-weight:bold;\n                position: absolute; min-width: 6cm;\">\n                {{ doc.account_no or '' }}\n            </span>\n            <span style=\"top:2.2cm; left:3.0cm; font-size:24px; \n                position: absolute; min-width: 6cm;\">\n                {{doc.party_name}}\n            </span>\n            <span style=\"top:3.6cm; left:3.0cm;\n                position: absolute; display: block; width: 15.0cm;\n                line-height:0.5cm; word-wrap: break-word;font-size:24px; \">\n                {{frappe.utils.money_in_words(doc.base_paid_amount or doc.base_received_amount)}}\n            </span>\n            <span style=\"top:3.7cm; left:21.0cm;\n                position: absolute; min-width: 4cm;font-size:24px; \">\n                {{doc.get_formatted(\"base_paid_amount\") or doc.get_formatted(\"base_received_amount\")}}\n            </span>\n            <!--<span style=\"top:6.0cm; left:10.0cm;-->\n            <!--    position: absolute; min-width: 6cm;\">-->\n            <!--    {{doc.company}}-->\n            <!--</span>-->\n\n        </div>\n    </div>\n</div>",
